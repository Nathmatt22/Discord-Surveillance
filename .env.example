# Jeton de TON compte Discord (pas un jeton de bot). Voir README.md.
DISCORD_USER_TOKEN=

# Clé de l'API IA. Avec le fournisseur « vyceai » (réglé dans config.json),
# c'est VYCEAI_API_KEY ; les fournisseurs « zai » utilisent AI_API_KEY.
VYCEAI_API_KEY=
AI_API_KEY=

# Optionnel : URL d'un webhook Discord pour recevoir les alertes.
# À créer dans le salon voulu : Paramètres du salon > Intégrations > Webhooks.
DISCORD_WEBHOOK_URL=

# Optionnel : alertes sur Telegram. Crée un bot avec @BotFather pour obtenir le jeton,
# puis active "notify.telegram" dans config.json et mets l'identifiant de la
# conversation dans "chat_id".
TELEGRAM_BOT_TOKEN=
